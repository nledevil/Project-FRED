venv/
__pycache__/
*.pyc
*.log
captures/
config/secrets.env
models/
# Terminator movie clips are copyrighted — keep them local, out of the repo.
sounds/terminator/*.wav

# Machine-local runtime state: persisted bench tuning (face-tracking gains),
# device paths, and API tokens. Defaults live in inmoov/settings.py, so a fresh
# checkout still runs without this file.
config/phrases.json
config/settings.json

# Compiled chest-panel animations: built per-machine from deploy/display/*.c
deploy/display/voice_hud
# Generated from theme.py by the Makefile, beside the binary above.
deploy/display/theme_colors.h
verify-*.raw
deploy/display/shaders/*.qsb
# heard.jsonl and friends: data, not source. The comment is on its own line
# because git has no trailing comments — with one appended, the whole line
# became the pattern and this directory was never ignored at all.
logs/
