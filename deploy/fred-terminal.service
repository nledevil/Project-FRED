# Reference copy. The INSTALLED copy lives at /etc/systemd/system/ and has a real
# password baked into the -c flag — keep that out of git. To install:
#   sudo cp deploy/fred-terminal.service /etc/systemd/system/
#   sudo sed -i "s/CHANGE_ME/<your password>/" /etc/systemd/system/fred-terminal.service
#   sudo chmod 600 /etc/systemd/system/fred-terminal.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now fred-terminal
# Requires: tmux (apt) and the ttyd x86_64 static binary at /usr/local/bin/ttyd.
[Unit]
Description=FRED browser terminal — the NUC brain (ttyd + tmux + Claude Code, :7681)
After=network-online.target
Wants=network-online.target
# One of three. The head and chest terminals (:7682, :7683) also run HERE and
# simply ssh out, rather than each Pi serving its own ttyd. The robot LAN is not
# routable from the house network — no ip_forward, no NAT, and dnsmasq hands out
# no option:router on purpose — so a browser on the house WiFi can reach the NUC
# and nothing behind it. Terminating all three on the NUC means every terminal is
# reachable wherever the panel itself is reachable, with no port forwarding.

[Service]
Type=simple
User=nledevil
Group=nledevil
WorkingDirectory=/home/nledevil/fred/Project-FRED
Environment=HOME=/home/nledevil
Environment=TERM=xterm-256color
Environment=LANG=C.UTF-8
# /usr/local/bin first: that is where claude lives.
Environment=PATH=/usr/local/bin:/home/nledevil/.local/bin:/usr/bin:/bin
# --check-origin blocks cross-site websocket hijacking; the panel opens this in a
# new tab (not an iframe) precisely so that check keeps passing.
# Do NOT port-forward this to the internet: HTTP basic auth is plaintext.
ExecStart=/usr/local/bin/ttyd -W -p 7681 -c fred:CHANGE_ME -m 3 --check-origin -t fontSize=15 /usr/bin/tmux new-session -A -s nuc -c /home/nledevil/fred/Project-FRED
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
