# The panel runs as nledevil and needs to switch the access point on and off.
# Narrow on purpose: exactly these three verbs on exactly this unit, nothing
# else, no shell. The panel is reachable from the LAN, so a broad NOPASSWD rule
# here would be a much bigger door than the feature is worth.
nledevil ALL=(root) NOPASSWD: /usr/bin/systemctl start fred-hotspot.service, /usr/bin/systemctl stop fred-hotspot.service, /usr/bin/systemctl restart fred-hotspot.service

# ...and to change the SSID and passphrase from the touchscreen, which means
# writing a root-owned file. Same reasoning: one fixed helper that takes no path
# and edits exactly two keys, rather than a rule that can write anywhere. The
# passphrase goes in on stdin, so it never appears in argv or in `ps`.
nledevil ALL=(root) NOPASSWD: /usr/local/sbin/fred-ap-config

# ...and to join a WiFi network from the panel or the web app. Same shape again:
# one fixed helper, no paths in argv, and the passphrase arrives on stdin so it
# never shows up in `ps`. It owns 60-fred-uplink.yaml and nothing else — the
# hand-written netplan file with the bridge in it is never opened for writing.
nledevil ALL=(root) NOPASSWD: /usr/local/sbin/fred-uplink
