# Location: /etc/network/interfaces
# Please modify network settings via: dietpi-config
# Or create your own drop-ins in: /etc/network/interfaces.d/

# Drop-in configs
source interfaces.d/*

# Ethernet
# Robot LAN: the switch behind the NUC. The NUC (10.0.0.1) serves DHCP
# with a MAC reservation for this Pi, so the address is stable, and it
# masquerades 10.0.0.0/24 out its own uplink (deploy/hotspot-nuc/fred-nat.nft),
# so the default route lives here — the same as the chest.
allow-hotplug eth0
iface eth0 inet static
    address 10.0.0.10
    netmask 255.255.255.0
    gateway 10.0.0.1
    dns-nameservers 1.1.1.1 8.8.8.8

# WiFi: none, on purpose (2026-09-28). This Pi is fed through a slim
# right-angle USB-C cable to fit the neck, and it logged ~160 under-voltage
# events in four days at idle. The radio was ~100 mA of that for nothing —
# every byte to and from this Pi goes over eth0. The radio is also disabled
# in the firmware (dtoverlay=disable-wifi in /boot/firmware/config.txt) so it
# never powers up at boot; re-enable both if the head ever needs its own
# uplink again.
