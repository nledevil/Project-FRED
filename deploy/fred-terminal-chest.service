# Reference copy — see fred-terminal.service for the install recipe (this one is
# port 7683). Keep the real password out of git.
[Unit]
Description=FRED browser terminal — chest Pi over ssh (ttyd + tmux, :7683)
After=network-online.target
Wants=network-online.target
# Runs on the NUC and sshes to the chest, rather than the chest serving its own
# ttyd. Two reasons: the robot LAN is not routable from the house network, so a
# ttyd on 10.0.0.10 is unreachable from a laptop; and the NUC already holds key
# auth to both Pis, so there is no second password to manage.
#
# The chest runs no ttyd of its own; this is the only browser shell into it.

[Service]
Type=simple
User=nledevil
Group=nledevil
WorkingDirectory=/home/nledevil
Environment=HOME=/home/nledevil
Environment=TERM=xterm-256color
Environment=LANG=C.UTF-8
Environment=PATH=/usr/local/bin:/home/nledevil/.local/bin:/usr/bin:/bin
# ssh reads ~/.ssh/config, so "chest" carries the right user, key and
# ServerAliveInterval.
#
# The tmux runs on the CHEST, not here — note it is after the ssh, not before it.
# Wrapping ssh in a NUC-side tmux instead would put the session that holds your
# work on the wrong side of the cable: the process runs on the chest as a child
# of the ssh, so an ethernet drop kills it. Running tmux on the far end means the
# session survives the link going down, and you reattach to the same work when it
# comes back — which on this robot is a matter of when, not if.
#
# Session name "claude" matches the head's, so the two Pis behave the same way.
# The chest serves no ttyd of its own, so this is the only door into that session.
# -t forces a pty, which tmux needs and ssh will not allocate for a command.
ExecStart=/usr/local/bin/ttyd -W -p 7683 -c fred:CHANGE_ME -m 3 --check-origin -t fontSize=15 /usr/bin/ssh -t chest tmux new-session -A -s claude
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
