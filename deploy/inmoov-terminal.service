# Reference copy of the browser-terminal unit. The INSTALLED copy lives at
# /etc/systemd/system/inmoov-terminal.service and has a real password baked into
# the -c flag — keep that out of git. Replace CHANGE_ME below before installing:
#   sudo cp deploy/inmoov-terminal.service /etc/systemd/system/
#   sudo sed -i "s/CHANGE_ME/$(tr -dc A-Za-z0-9 </dev/urandom | head -c20)/" \
#            /etc/systemd/system/inmoov-terminal.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now inmoov-terminal
# Requires: tmux (apt) and the ttyd aarch64 static binary at /usr/local/bin/ttyd.
[Unit]
Description=InMoov browser terminal (ttyd + tmux + Claude Code)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dietpi
Group=dietpi
WorkingDirectory=/home/dietpi/inmoov
Environment=HOME=/home/dietpi
Environment=TERM=xterm-256color
Environment=LANG=C.UTF-8
Environment=PATH=/home/dietpi/.local/bin:/usr/local/bin:/usr/bin:/bin
# Serves a browser terminal on :7681, HTTP basic-auth (user "fred"), attaching
# a persistent tmux session. --check-origin blocks cross-site websocket hijacking.
# Do NOT port-forward :7681 to the internet (HTTP basic auth is plaintext).
ExecStart=/usr/local/bin/ttyd -W -p 7681 -c fred:CHANGE_ME -m 3 --check-origin -t fontSize=15 /usr/bin/tmux new-session -A -s claude -c /home/dietpi/inmoov
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
