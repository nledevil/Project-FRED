[Unit]
Description=Bluetooth PAN client (chest -> head, 10.0.0.2)
Documentation=file:///home/dietpi/inmoov/HOTSPOT.md
After=bluetooth.service bthelper@hci0.service
Requires=bluetooth.service
# bt-network asserts (SEGV/ABRT) instead of erroring whenever the adapter or the
# peer is not ready, so this unit *will* fail sometimes and must retry forever:
# if the head is powered off for hours, the chest has to keep trying rather than
# trip systemd's default start-limit (5 starts / 10s) and give up permanently.
StartLimitIntervalSec=0

[Service]
Type=simple
# pi-bluetooth's bthelper forks a "(sleep 5; bluetoothctl power off; power on)"
# reinit ~5s after it runs, which lands squarely on bt-network's connect and
# takes the adapter down under it -- one guaranteed crash per boot. Wait that
# out, then require a powered adapter and a known bonded head before starting.
ExecStartPre=/bin/sleep 10
ExecStartPre=/bin/sh -c "for i in $(seq 1 30); do bluetoothctl show 2>/dev/null | grep -q 'Powered: yes' && bluetoothctl info E4:5F:01:49:60:BB >/dev/null 2>&1 && exit 0; sleep 2; done; exit 0"
ExecStart=/usr/bin/bt-network -c E4:5F:01:49:60:BB nap
# bnep0 appears a moment after the link is up, and carries no DHCP -- the address
# is static on both ends.
ExecStartPost=/bin/sh -c 'for i in $(seq 1 15); do ip link show bnep0 >/dev/null 2>&1 && break; sleep 1; done; ip addr add 10.0.0.2/24 dev bnep0 2>/dev/null || true; ip link set bnep0 up'
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
